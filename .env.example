DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,assist
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Homigo main API (the assistant acts with the signed-in user's own token)
HOMIGO_API_URL=http://localhost:8000/api/v1

# none = built-in rule-based assistant (no key). groq | gemini | openai_compat = AI mode.
LLM_PROVIDER=none
LLM_API_KEY=
# Optional overrides; check your provider console for current model names.
LLM_MODEL=
LLM_BASE_URL=
LLM_DAILY_CALL_LIMIT=1000
